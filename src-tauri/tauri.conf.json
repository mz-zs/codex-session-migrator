{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Session Migrator",
  "version": "0.1.0",
  "identifier": "local.codex-session-migrator",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Codex 会话迁移",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
